# totalrecalls_logo_animated.py
# Animated Futuristic Multi-Node Matrix Logo (Inward Convergence)
# Author: Andre (TotalRecalls.app)

import matplotlib.pyplot as plt
import numpy as np
from matplotlib.animation import FuncAnimation

fig, ax = plt.subplots(figsize=(6, 6))
ax.set_facecolor("#0B0C10")
ax.axis("off")

# Grid parameters
grid_size = 3
spacing = 1.2
square_size = 0.6

# Colors
outer_color = "#1E1F22"      # Deep Slate
center_color = "#3A7BFF"     # Electric Blue
beam_color = "#4BE1D4"       # Signal Cyan

# Draw grid squares
for i in range(grid_size):
    for j in range(grid_size):
        x = (i - 1) * spacing
        y = (j - 1) * spacing
        color = center_color if (i == 1 and j == 1) else outer_color
        rect = plt.Rectangle((x - square_size/2, y - square_size/2),
                             square_size, square_size,
                             color=color, ec=None)
        ax.add_patch(rect)

# Beam origins (corners to center)
beam_origins = [(-2, 2), (2, 2), (-2, -2), (2, -2)]
beam_lines = []

# Initialize beams
for (x0, y0) in beam_origins:
    line, = ax.plot([], [], color=beam_color, linewidth=2, alpha=0.6)
    beam_lines.append(line)

# Central glow
glow = plt.Circle((0, 0), 0.4, color=center_color, alpha=0.8)
ax.add_patch(glow)

# Animation function
def animate(frame):
    t = np.linspace(0, 1, 100)
    progress = frame / 100
    for idx, (x0, y0) in enumerate(beam_origins):
        x_curve = (1 - t)**2 * x0 + 2*(1 - t)*t*(x0 * 0.5) + t**2 * 0
        y_curve = (1 - t)**2 * y0 + 2*(1 - t)*t*(y0 * 0.5) + t**2 * 0
        # Animate partial beam length
        end_idx = int(progress * len(t))
        beam_lines[idx].set_data(x_curve[:end_idx], y_curve[:end_idx])
    # Pulse glow
    glow.set_alpha(0.6 + 0.4 * np.sin(frame / 10))
    return beam_lines + [glow]

# Run animation
anim = FuncAnimation(fig, animate, frames=120, interval=40, blit=True)
plt.tight_layout()
plt.show()
🧠 How it works
Each beam animates inward from the corners toward the center.

The glow pulses softly to simulate data absorption.

You can export this animation as a GIF or MP4 using anim.save("totalrecalls_logo.mp4").

