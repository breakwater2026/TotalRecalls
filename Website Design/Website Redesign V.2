# totalrecalls_logo.py
# Futuristic Multi-Node Matrix Logo (Inward Convergence)
# Author: Andre (TotalRecalls.app)

import matplotlib.pyplot as plt
import numpy as np

fig, ax = plt.subplots(figsize=(6, 6))
ax.set_facecolor("#0B0C10")  # dark background
ax.axis("off")

# Grid parameters
grid_size = 3
spacing = 1.2
square_size = 0.6

# Colors
outer_color = "#1E1F22"      # Deep Slate
center_color = "#3A7BFF"     # Electric Blue
beam_color = "#4BE1D4"       # Signal Cyan

# Draw grid squares
for i in range(grid_size):
    for j in range(grid_size):
        x = (i - 1) * spacing
        y = (j - 1) * spacing
        color = center_color if (i == 1 and j == 1) else outer_color
        rect = plt.Rectangle((x - square_size/2, y - square_size/2),
                             square_size, square_size,
                             color=color, ec=None)
        ax.add_patch(rect)

# Draw inward beams (curved)
def draw_beam(x_start, y_start, x_end, y_end, curvature=0.3):
    t = np.linspace(0, 1, 100)
    x_curve = (1 - t)**2 * x_start + 2*(1 - t)*t*(x_start + curvature*(x_end - x_start)) + t**2 * x_end
    y_curve = (1 - t)**2 * y_start + 2*(1 - t)*t*(y_start + curvature*(y_end - y_start)) + t**2 * y_end
    ax.plot(x_curve, y_curve, color=beam_color, linewidth=2, alpha=0.6)

# Beam positions (corners to center)
beam_origins = [(-2, 2), (2, 2), (-2, -2), (2, -2)]
for (x0, y0) in beam_origins:
    draw_beam(x0, y0, 0, 0)

# Central glow
glow = plt.Circle((0, 0), 0.4, color=center_color, alpha=0.8)
ax.add_patch(glow)

plt.tight_layout()
plt.show()
