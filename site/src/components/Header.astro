---
const links = [
  { href: "/", label: "Home" },
  { href: "/how-it-works/", label: "How It Works" },
  { href: "/guides/", label: "Guides" },
  { href: "/compare/", label: "Compare" },
  { href: "/pricing/", label: "Pricing" },
  { href: "/download/", label: "Download" },
];
---
<nav class="v6-nav">
  <a href="/" class="brand" style="display: flex; align-items: center; text-decoration: none;">
    <img src="/logo.png" alt="TotalRecalls" style="height: 150px; max-height: 150px; width: auto; display: block;" />
  </a>
  <span class="nav-links">
    {
      links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))
    }
    <a href="/pricing/" class="buy-button" data-tr-buy>Buy — $24</a>
  </span>
</nav>

<style>
  .v6-nav {
    padding: var(--space-6) var(--space-8);
  }
</style>
