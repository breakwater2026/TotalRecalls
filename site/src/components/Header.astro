---
// Base44 Nav — sticky header with Leonardo AI logo at compact 26px height
const LINKS = [
  { label: "How It Works", href: "#resolution" },
  { label: "Providers", href: "#matrix" },
  { label: "Library", href: "#library" },
  { label: "Guides", href: "#guides" },
  { label: "Pricing", href: "#pricing" },
  { label: "Legals", href: "/legals/" },
];
---
<header class="tr-nav">
  <div class="tr-nav-inner">
    <a href="#top" class="tr-brand">
      <img src="/logo.png" alt="TotalRecalls" class="tr-logo-img" />
    </a>
    <nav class="tr-nav-links">
      {LINKS.map((l) => (
        <a href={l.href} class="tr-nav-link">{l.label}</a>
      ))}
    </nav>
    <div class="tr-nav-actions">
      <button
        type="button"
        data-theme-toggle
        class="theme-toggle"
        aria-label="Toggle theme"
        title="Toggle theme"
      >
        <span data-icon-sun class="inline-block">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        </span>
        <span data-icon-moon class="hidden inline-block">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </span>
      </button>
      <a href="#pricing" class="tr-download-link">Download</a>
      <a href="#pricing" class="tr-buy-btn">
        Buy — $24
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>
  </div>
</header>

<style>
  .tr-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #E2E8F0;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid #E2E8F0;
    background: transparent;
    color: #64748B;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }
  .theme-toggle:hover {
    color: #0B0F19;
    background: rgba(11, 15, 25, 0.05);
  }
  .tr-nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .tr-brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .tr-logo-img {
    height: 26px;
    max-height: 26px;
    width: auto;
    display: block;
  }
  .tr-nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .tr-nav-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #64748B;
    text-decoration: none;
    transition: color 0.2s;
  }
  .tr-nav-link:hover {
    color: #0B0F19;
  }
  .tr-nav-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .tr-download-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #64748B;
    text-decoration: none;
  }
  .tr-download-link:hover {
    color: #0B0F19;
  }
  .tr-buy-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #2F7BFF;
    color: #FFFFFF;
    padding: 8px 16px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .tr-buy-btn:hover {
    opacity: 0.9;
  }
  @media (max-width: 900px) {
    .tr-nav-links, .tr-download-link { display: none; }
  }
  /* Dark theme — Grok-derived true black (#101113) surfaces */
  [data-theme="dark"] .tr-nav {
    background: rgba(16, 17, 19, 0.95);
    border-bottom-color: #26282c;
  }
  [data-theme="dark"] .tr-nav-link,
  [data-theme="dark"] .tr-download-link,
  [data-theme="dark"] .theme-toggle {
    color: #9BA1A6;
  }
  [data-theme="dark"] .tr-nav-link:hover,
  [data-theme="dark"] .tr-download-link:hover,
  [data-theme="dark"] .theme-toggle:hover {
    color: #E6E8EB;
  }
  [data-theme="dark"] .theme-toggle {
    border-color: #26282c;
  }
  [data-theme="dark"] .theme-toggle:hover {
    background: rgba(255, 255, 255, 0.06);
  }
</style>
