---
const links = [
  { href: "/", label: "Home" },
  { href: "/how-it-works/", label: "How It Works" },
  { href: "/guides/", label: "Guides" },
  { href: "/compare/", label: "Compare" },
  { href: "/pricing/", label: "Pricing" },
  { href: "/download/", label: "Download" },
];
---
<nav>
  <a href="/" class="brand" style="display: flex; align-items: center; text-decoration: none;">
    <img src="/logo.png" alt="TotalRecalls" style="height: 38px; width: auto; display: block;" />
  </a>
  <span class="nav-links">
    {
      links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))
    }
    <a href="/pricing/" class="buy-button" data-tr-buy>Buy — $24</a>
  </span>
</nav>
