---
import MockWindows from "./MockWindows.astro";
---
<section class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1>Own every AI conversation.</h1>
      <p class="subhead">A small Windows app that saves your ChatGPT, Claude, Perplexity, Gemini, and Grok chats into a private folder on your computer — readable Markdown + JSON you keep forever.</p>
      <div class="price-block">
        <span class="price-current">$24</span>
        <span class="price-badge">launch price</span>
        <span class="price-note">One-time purchase · Windows app · Local files only</span>
      </div>
      <p class="cta-group">
        <a href="/pricing/" class="buy-button buy-lg" data-tr-buy>Buy TotalRecalls — $24</a>
        <a href="/download/" class="buy-button buy-secondary">Already purchased? Download ZIP</a>
      </p>
      <p class="guarantee-note">14-day money-back guarantee. If TotalRecalls doesn't work for you, email us and we'll refund it — no questions asked.</p>
      <p class="early-access-note">Early access build. Actively improving based on user feedback.</p>
      <p class="founder-note">Built by a solo developer who was tired of losing months of AI conversations to broken exports and shifting UIs.</p>
    </div>
    <div class="hero-shots">
      <MockWindows variant="library" />
      <MockWindows variant="markdown" />
    </div>
  </div>
</section>
