---
import MockWindows from "./MockWindows.astro";
---
<section class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1>Own every AI conversation.</h1>
      <p class="subhead">A small Windows app that saves your ChatGPT, Claude, Perplexity, Gemini, and Grok chats into a private folder on your computer — readable Markdown + JSON you keep forever.</p>
      <div class="price-block">
        <span class="price-current">$24</span>
        <span class="price-badge">launch price</span>
        <span class="price-note">One-time purchase · Windows app · Local files only</span>
      </div>
      <p class="cta-group">
        <a href="/buy/" class="buy-button buy-lg" data-tr-buy>Buy TotalRecalls — $24</a>
        <a href="/download/" class="buy-button buy-secondary">Download ZIP</a>
      </p>
    </div>
    <div class="hero-shots">
      <MockWindows variant="library" />
      <MockWindows variant="markdown" />
    </div>
  </div>
</section>
