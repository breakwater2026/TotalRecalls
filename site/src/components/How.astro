---
const steps = [
  { n: "1", title: "Buy once", text: "Checkout via order processor." },
  { n: "2", title: "Install", text: "Unzip and run the Windows app." },
  { n: "3", title: "Pick a provider", text: "ChatGPT, Claude, Perplexity, Gemini, or Grok." },
  { n: "4", title: "Download", text: "Chats land as Markdown + JSON under a Library folder." },
];
---
<section class="how-it-works">
  <div class="section-inner">
    <h2>How It Works</h2>
    <ol class="step-list">
      {
        steps.map((s) => (
          <li>
            <span class="step-icon">{s.n}</span>
            <span><strong>{s.title}</strong> — {s.text}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
