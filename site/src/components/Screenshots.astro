---
import MockWindows from "./MockWindows.astro";
---
<section class="screenshots">
  <div class="section-inner">
    <h2>Your Library, organized</h2>
    <div class="screenshot-grid">
      <div class="screenshot-card">
        <MockWindows variant="library" />
        <p>Clean folder structure you can browse, search, and back up.</p>
      </div>
      <div class="screenshot-card">
        <MockWindows variant="markdown" />
        <p>Predictable formatting. Easy to diff, annotate, or feed into your own tools.</p>
      </div>
    </div>
  </div>
</section>
