---
const pillars = [
  {
    title: "Your AI history shouldn't vanish",
    text: "Tabs close. Downloads break. Interfaces change. A folder of Markdown on your PC still opens in ten years.",
  },
  {
    title: "One library for every assistant",
    text: "Download everything into a single, predictable folder structure.",
  },
  {
    title: "Private by design",
    text: "Local sign-in. No cloud locker. No account. No subscription.",
  },
];
---
<section class="value-cards">
  <div class="section-inner">
    <h2>Why TotalRecalls</h2>
    <div class="why-grid">
      {
        pillars.map((p) => (
          <div class="card">
            <strong>{p.title}</strong>
            <p>{p.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
