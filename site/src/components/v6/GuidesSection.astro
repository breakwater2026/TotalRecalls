---
// Base44 Guides — Guides · 04 (1:1 port)
const GUIDES = [
  { t: "Export ChatGPT conversations", d: "Official export vs a local library you can actually use", tag: "guide · 01" },
  { t: "Download your Claude history", d: "Keep Projects and long threads as files", tag: "guide · 02" },
  { t: "Backup Perplexity threads", d: "Save research threads before you lose the tab trail", tag: "guide · 03" },
  { t: "Gemini Takeout → Markdown", d: "Turn Google Takeout dumps into Markdown conversations", tag: "guide · 04" },
  { t: "Own your AI chat data", d: "Why multi-assistant export matters in 2026", tag: "guide · 05" },
];
---
<section id="guides" class="tr-section">
  <div class="tr-container">
    <header class="tr-guides-header">
      <div>
        <span class="tr-kicker">Guides · 04</span>
        <h2 class="tr-section-title">Free reading. Buy only when you want the app.</h2>
      </div>
      <p class="tr-guides-badge">No email gate · No AdSense</p>
    </header>
    <div class="tr-guides-list">
      {GUIDES.map((g) => (
        <a href="#pricing" class="tr-guide-row">
          <span class="tr-guide-tag">{g.tag}</span>
          <div class="tr-guide-body">
            <h3 class="tr-guide-title">{g.t}</h3>
            <p class="tr-guide-desc">{g.d}</p>
          </div>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tr-guide-arrow"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .tr-section { border-top: 1px solid #E2E8F0; background: #FFFFFF; }
  .tr-container { max-width: 1400px; margin: 0 auto; padding: 80px 40px 112px; }
  .tr-kicker {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #2F7BFF;
  }
  .tr-section-title {
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 12px 0 0 0;
    color: #0B0F19;
  }
  .tr-guides-header {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 40px;
  }
  .tr-guides-badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: 0;
  }
  .tr-guides-list { border-top: 1px solid #E2E8F0; }
  .tr-guide-row {
    display: flex;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid #E2E8F0;
    padding: 24px 8px;
    text-decoration: none;
    transition: background 0.2s;
    margin: 0 -8px;
  }
  .tr-guide-row:hover { background: rgba(241, 245, 249, 0.3); }
  .tr-guide-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #64748B;
    width: 80px;
    flex-shrink: 0;
  }
  .tr-guide-body { flex: 1; }
  .tr-guide-title {
    font-size: 20px;
    font-weight: 600;
    margin: 0;
    color: #0B0F19;
    transition: color 0.2s;
  }
  .tr-guide-row:hover .tr-guide-title { color: #2F7BFF; }
  .tr-guide-desc {
    font-size: 14px;
    color: #64748B;
    margin: 4px 0 0 0;
  }
  .tr-guide-arrow {
    color: #64748B;
    flex-shrink: 0;
    transition: color 0.2s;
  }
  .tr-guide-row:hover .tr-guide-arrow { color: #2F7BFF; }
</style>
