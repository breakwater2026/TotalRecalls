---
// Landing Page Hero (Exact Base44 Spacing & Positioning)
---
<section class="v6-hero">
  <div class="hero-container">
    <div class="hero-left">
      <div class="hero-badge">
        <span>FORENSIC GUARDIAN · V1.0</span>
      </div>
      <h1 class="hero-title">Recall every AI conversation.</h1>
      <p class="hero-subhead">
        A Windows app that exports your ChatGPT, Claude, Perplexity, Gemini, and Grok chats into a private folder of Markdown + JSON you keep forever — long after the tab closes and the UI changes.
      </p>

      <div class="hero-scan-bar">
        <input type="text" placeholder="Verify a conversation is safe — thread, date, or provider..." readonly />
        <button class="scan-btn" aria-label="Scan">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect></svg>
          <span>SCAN</span>
        </button>
      </div>

      <div class="hero-cta-group">
        <a href="/pricing/" class="buy-button buy-lg" data-tr-buy>BUY TOTALRECALLS — $24 &rarr;</a>
        <a href="/download/" class="buy-secondary buy-lg" data-tr-download>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          DOWNLOAD ZIP
        </a>
      </div>

      <div class="hero-feature-row">
        <div class="feature-card">
          <div class="f-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </div>
          <div class="f-text">
            <strong>Private by design</strong>
            <span>Local sign-in · no cloud</span>
          </div>
        </div>
        <div class="feature-card">
          <div class="f-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
          </div>
          <div class="f-text">
            <strong>One library</strong>
            <span>Every assistant, one folder</span>
          </div>
        </div>
        <div class="feature-card">
          <div class="f-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 8v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <div class="f-text">
            <strong>Yours forever</strong>
            <span>Markdown opens in 10 yrs</span>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-right">
      <div class="blueprint-diagram">
        <div class="diag-header">
          <span class="diag-title"><span class="live-dot"></span>CONVERGENCE · LIVE</span>
          <span class="diag-status">5 SOURCES → 1 FOLDER</span>
        </div>
        <div class="diag-body convergence-body">
          <svg viewBox="0 0 560 300" class="convergence-svg" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <filter id="dotGlow" x="-100%" y="-100%" width="300%" height="300%">
                <feGaussianBlur stdDeviation="1.8" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>

            <!-- Convergence paths (vibrant electric blue dashed lines) -->
            <path id="convPath1" d="M205 46 C 295 46, 330 82, 416 86" class="conv-path"/>
            <path id="convPath2" d="M205 94 C 295 94, 330 112, 416 116" class="conv-path"/>
            <path id="convPath3" d="M205 142 C 295 142, 330 142, 416 146" class="conv-path"/>
            <path id="convPath4" d="M205 190 C 295 190, 330 172, 416 176" class="conv-path"/>
            <path id="convPath5" d="M205 238 C 295 238, 330 202, 416 206" class="conv-path"/>

            <!-- Square nodes along paths -->
            <rect x="250" y="43" width="6" height="6" class="conv-node"/>
            <rect x="250" y="91" width="6" height="6" class="conv-node"/>
            <rect x="250" y="139" width="6" height="6" class="conv-node"/>
            <rect x="250" y="187" width="6" height="6" class="conv-node"/>
            <rect x="250" y="235" width="6" height="6" class="conv-node"/>
            <rect x="330" y="66" width="6" height="6" class="conv-node"/>
            <rect x="330" y="112" width="6" height="6" class="conv-node"/>
            <rect x="330" y="146" width="6" height="6" class="conv-node"/>
            <rect x="330" y="176" width="6" height="6" class="conv-node"/>
            <rect x="330" y="216" width="6" height="6" class="conv-node"/>

            <!-- Moving data bullets (animated electric blue dots) -->
            <circle r="5" class="conv-dot" filter="url(#dotGlow)">
              <animateMotion dur="2.4s" repeatCount="indefinite" rotate="0">
                <mpath href="#convPath1"/>
              </animateMotion>
            </circle>
            <circle r="5" class="conv-dot" filter="url(#dotGlow)">
              <animateMotion dur="2.8s" repeatCount="indefinite" rotate="0">
                <mpath href="#convPath2"/>
              </animateMotion>
            </circle>
            <circle r="5" class="conv-dot" filter="url(#dotGlow)">
              <animateMotion dur="2.2s" repeatCount="indefinite" rotate="0">
                <mpath href="#convPath3"/>
              </animateMotion>
            </circle>
            <circle r="5" class="conv-dot" filter="url(#dotGlow)">
              <animateMotion dur="3.0s" repeatCount="indefinite" rotate="0">
                <mpath href="#convPath4"/>
              </animateMotion>
            </circle>
            <circle r="5" class="conv-dot" filter="url(#dotGlow)">
              <animateMotion dur="2.5s" repeatCount="indefinite" rotate="0">
                <mpath href="#convPath5"/>
              </animateMotion>
            </circle>

            <!-- Source rows (ChatGPT, Claude, Perplexity, Gemini, Grok) -->
            <g class="source-row">
              <rect x="0" y="32" width="26" height="26" rx="6" class="source-icon"/>
              <path d="M13 38 v10 M9.5 44 L13 48 L16.5 44" class="source-arrow"/>
              <text x="36" y="44" class="source-name">ChatGPT</text>
              <text x="36" y="56" class="source-code">DAI-001</text>
            </g>
            <g class="source-row">
              <rect x="0" y="80" width="26" height="26" rx="6" class="source-icon"/>
              <path d="M13 86 v10 M9.5 92 L13 96 L16.5 92" class="source-arrow"/>
              <text x="36" y="92" class="source-name">Claude</text>
              <text x="36" y="104" class="source-code">ANT-002</text>
            </g>
            <g class="source-row">
              <rect x="0" y="128" width="26" height="26" rx="6" class="source-icon"/>
              <path d="M13 134 v10 M9.5 140 L13 144 L16.5 140" class="source-arrow"/>
              <text x="36" y="140" class="source-name">Perplexity</text>
              <text x="36" y="152" class="source-code">PPL-003</text>
            </g>
            <g class="source-row">
              <rect x="0" y="176" width="26" height="26" rx="6" class="source-icon"/>
              <path d="M13 182 v10 M9.5 188 L13 192 L16.5 188" class="source-arrow"/>
              <text x="36" y="188" class="source-name">Gemini</text>
              <text x="36" y="200" class="source-code">GEM-004</text>
            </g>
            <g class="source-row">
              <rect x="0" y="224" width="26" height="26" rx="6" class="source-icon"/>
              <path d="M13 230 v10 M9.5 236 L13 240 L16.5 236" class="source-arrow"/>
              <text x="36" y="236" class="source-name">Grok</text>
              <text x="36" y="248" class="source-code">GRK-005</text>
            </g>

            <!-- Destination folder box -->
            <rect x="416" y="62" width="138" height="178" rx="10" class="dest-box"/>
            <g class="dest-folder">
              <path d="M428 104 h14 l4 4 h18 a3 3 0 0 1 3 3 v26 a3 3 0 0 1 -3 3 h-36 a3 3 0 0 1 -3 -3 v-30 a3 3 0 0 1 3 -3 z"/>
            </g>
            <text x="428" y="158" class="dest-path">C:\TotalRecalls\Library\</text>
            <text x="428" y="180" class="dest-status">797 files · secured</text>
            <text x="428" y="222" class="dest-note">One folder. Searchable.</text>
            <text x="428" y="238" class="dest-note">Backups yours.</text>
          </svg>
        </div>
        <div class="diag-footer">
          <span>Zero cloud relay · Direct disk write</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .v6-hero {
    background: #FFFFFF;
    color: #0F172A;
    padding: var(--space-8) var(--space-4);
    border-bottom: 1px solid #E2E8F0;
    position: relative;
    background-image: linear-gradient(to right, #F8FAFC 1px, transparent 1px),
                      linear-gradient(to bottom, #F8FAFC 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .hero-container {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-8);
    align-items: center;
  }
  .hero-badge {
    display: inline-block;
    border: 1px solid #2F7BFF;
    color: #2F7BFF;
    padding: 4px 10px;
    border-radius: 4px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: var(--space-3);
  }
  .hero-title {
    font-size: clamp(2.4rem, 4.5vw, 3.25rem);
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -1px;
    line-height: 1.15;
    margin-bottom: var(--space-3);
  }
  .hero-subhead {
    font-size: 1.05rem;
    color: #475569;
    line-height: 1.55;
    margin-bottom: var(--space-5);
  }
  .hero-scan-bar {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 6px 6px 6px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'IBM Plex Mono', monospace;
    margin-bottom: var(--space-5);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
  }
  .hero-scan-bar input {
    background: transparent;
    border: none;
    color: #0F172A;
    font-size: 0.88rem;
    width: 100%;
    outline: none;
    font-family: inherit;
  }
  .hero-scan-bar input::placeholder {
    color: #94A3B8;
  }
  .scan-btn {
    background: #0F172A;
    color: #FFFFFF;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }
  .hero-cta-group {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .buy-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid #CBD5E1;
    color: #0F172A;
    background: #FFFFFF;
    padding: var(--space-3) var(--space-5);
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
  }
  .hero-feature-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid #E2E8F0;
  }
  .feature-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .f-icon {
    color: #2F7BFF;
    margin-top: 2px;
  }
  .f-text strong {
    display: block;
    font-size: 0.88rem;
    color: #0F172A;
    font-weight: 700;
  }
  .f-text span {
    font-size: 0.78rem;
    color: #64748B;
    line-height: 1.3;
    display: block;
  }

  /* Blueprint Diagram — Light/White Theme */
  .blueprint-diagram {
    background: #FFFFFF;
    border: 1.5px solid #2F7BFF;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(47, 123, 255, 0.12);
    font-family: 'IBM Plex Mono', monospace;
  }
  .diag-header {
    background: #FFFFFF;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #E2E8F0;
    font-size: 0.75rem;
  }
  .diag-title {
    color: #0F172A;
    font-weight: 700;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    background: #10B981;
    border-radius: 50%;
    box-shadow: 0 0 6px #10B981;
    display: inline-block;
  }
  .diag-status {
    color: #2F7BFF;
    font-weight: 700;
  }
  .diag-body {
    padding: var(--space-5);
    background: #F8FBFF;
    background-image: linear-gradient(to right, #EFF6FF 1px, transparent 1px),
                      linear-gradient(to bottom, #EFF6FF 1px, transparent 1px);
    background-size: 20px 20px;
  }
  .convergence-svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .conv-path {
    fill: none;
    stroke: #2F7BFF;
    stroke-width: 2;
    stroke-dasharray: 6,4;
    opacity: 0.85;
  }
  .conv-node {
    fill: #2F7BFF;
  }
  .conv-dot {
    fill: #2F7BFF;
  }
  .source-icon {
    fill: #0F172A;
  }
  .source-arrow {
    fill: none;
    stroke: #FFFFFF;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .source-name {
    fill: #0F172A;
    font-size: 13px;
    font-weight: 700;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .source-code {
    fill: #64748B;
    font-size: 10px;
    font-family: 'IBM Plex Mono', monospace;
  }
  .dest-box {
    fill: #EFF6FF;
    stroke: #2F7BFF;
    stroke-width: 1.8;
  }
  .dest-folder path {
    fill: none;
    stroke: #2F7BFF;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .dest-path {
    fill: #0F172A;
    font-size: 11px;
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 700;
  }
  .dest-status {
    fill: #2F7BFF;
    font-size: 11px;
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 700;
  }
  .dest-note {
    fill: #475569;
    font-size: 10px;
    font-family: 'IBM Plex Mono', monospace;
  }
  .diag-footer {
    background: #FFFFFF;
    padding: 10px 16px;
    text-align: center;
    font-size: 0.7rem;
    color: #64748B;
    border-top: 1px solid #E2E8F0;
  }
  @media (max-width: 900px) {
    .hero-container { grid-template-columns: 1fr; }
    .hero-feature-row { grid-template-columns: 1fr; }
  }
</style>
