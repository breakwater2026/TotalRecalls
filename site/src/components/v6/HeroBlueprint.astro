---
// Base44 SentinelHero — hero section (1:1 port)
const TRUST = [
  { icon: "lock", l: "Private by design", s: "Local sign-in · no cloud" },
  { icon: "database", l: "One library", s: "Every assistant, one folder" },
  { icon: "shield", l: "Yours forever", s: "Markdown opens in 10 yrs" },
];
---
<section id="top" class="tr-hero">
  <div class="tr-hero-grid-bg"></div>
  <div class="tr-hero-inner">
    <div class="tr-hero-grid">
      <div class="tr-hero-left">
        <span class="tr-hero-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 8v7c0 6 8 10 8 10z"></path></svg>
          Forensic Guardian · v1.0
        </span>
        <h1 class="tr-hero-title">Recall every AI conversation.</h1>
        <p class="tr-hero-subhead">
          A Windows app that exports your ChatGPT, Claude, Perplexity, Gemini, and Grok chats into a private folder of Markdown + JSON you keep forever — long after the tab closes and the UI changes.
        </p>

        <form class="tr-scan-form">
          <div class="tr-scan-row">
            <span class="tr-scan-mark">▍</span>
            <input type="text" placeholder="Verify a conversation is safe — thread, date, or provider…" class="tr-scan-input" />
            <button type="button" class="tr-scan-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
              Scan
            </button>
          </div>
        </form>

        <div class="tr-hero-ctas">
          <a href="#pricing" class="tr-cta-primary">
            Buy TotalRecalls — $24
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="#pricing" class="tr-cta-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Download ZIP
          </a>
        </div>

        <div class="tr-trust-row">
          {TRUST.map((x) => (
            <div class="tr-trust-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tr-trust-icon">
                {x.icon === "lock" && <><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></>}
                {x.icon === "database" && <><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></>}
                {x.icon === "shield" && <path d="M12 22s8-4 8-10V5l-8-3-8 8v7c0 6 8 10 8 10z"></path>}
              </svg>
              <p class="tr-trust-title">{x.l}</p>
              <p class="tr-trust-sub">{x.s}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="tr-hero-right">
        <!-- ConvergenceDiagram -->
        <div class="blueprint-diagram">
          <div class="diag-header">
            <span class="diag-title"><span class="live-dot"></span>CONVERGENCE · LIVE</span>
            <span class="diag-status">5 SOURCES → 1 FOLDER</span>
          </div>
          <div class="diag-body convergence-body">
            <svg viewBox="0 0 560 300" class="convergence-svg" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <filter id="dotGlow" x="-100%" y="-100%" width="300%" height="300%">
                  <feGaussianBlur stdDeviation="1.8" result="blur" />
                  <feMerge>
                    <feMergeNode in="blur" />
                    <feMergeNode in="SourceGraphic" />
                  </feMerge>
                </filter>
              </defs>

              <path id="convPath1" d="M205 46 C 295 46, 330 82, 416 86" class="conv-path"/>
              <path id="convPath2" d="M205 94 C 295 94, 330 112, 416 116" class="conv-path"/>
              <path id="convPath3" d="M205 142 C 295 142, 330 142, 416 146" class="conv-path"/>
              <path id="convPath4" d="M205 190 C 295 190, 330 172, 416 176" class="conv-path"/>
              <path id="convPath5" d="M205 238 C 295 238, 330 202, 416 206" class="conv-path"/>

              <rect x="250" y="43" width="6" height="6" class="conv-node"/>
              <rect x="250" y="91" width="6" height="6" class="conv-node"/>
              <rect x="250" y="139" width="6" height="6" class="conv-node"/>
              <rect x="250" y="187" width="6" height="6" class="conv-node"/>
              <rect x="250" y="235" width="6" height="6" class="conv-node"/>
              <rect x="330" y="66" width="6" height="6" class="conv-node"/>
              <rect x="330" y="112" width="6" height="6" class="conv-node"/>
              <rect x="330" y="146" width="6" height="6" class="conv-node"/>
              <rect x="330" y="176" width="6" height="6" class="conv-node"/>
              <rect x="330" y="216" width="6" height="6" class="conv-node"/>

              <circle r="5" class="conv-dot" filter="url(#dotGlow)">
                <animateMotion dur="2.4s" repeatCount="indefinite" rotate="0"><mpath href="#convPath1"/></animateMotion>
              </circle>
              <circle r="5" class="conv-dot" filter="url(#dotGlow)">
                <animateMotion dur="2.8s" repeatCount="indefinite" rotate="0"><mpath href="#convPath2"/></animateMotion>
              </circle>
              <circle r="5" class="conv-dot" filter="url(#dotGlow)">
                <animateMotion dur="2.2s" repeatCount="indefinite" rotate="0"><mpath href="#convPath3"/></animateMotion>
              </circle>
              <circle r="5" class="conv-dot" filter="url(#dotGlow)">
                <animateMotion dur="3.0s" repeatCount="indefinite" rotate="0"><mpath href="#convPath4"/></animateMotion>
              </circle>
              <circle r="5" class="conv-dot" filter="url(#dotGlow)">
                <animateMotion dur="2.5s" repeatCount="indefinite" rotate="0"><mpath href="#convPath5"/></animateMotion>
              </circle>

              <g class="source-row">
                <rect x="0" y="32" width="26" height="26" rx="6" class="source-icon"/>
                <path d="M13 38 v10 M9.5 44 L13 48 L16.5 44" class="source-arrow"/>
                <text x="36" y="44" class="source-name">ChatGPT</text>
                <text x="36" y="56" class="source-code">DAI-001</text>
              </g>
              <g class="source-row">
                <rect x="0" y="80" width="26" height="26" rx="6" class="source-icon"/>
                <path d="M13 86 v10 M9.5 92 L13 96 L16.5 92" class="source-arrow"/>
                <text x="36" y="92" class="source-name">Claude</text>
                <text x="36" y="104" class="source-code">ANT-002</text>
              </g>
              <g class="source-row">
                <rect x="0" y="128" width="26" height="26" rx="6" class="source-icon"/>
                <path d="M13 134 v10 M9.5 140 L13 144 L16.5 140" class="source-arrow"/>
                <text x="36" y="140" class="source-name">Perplexity</text>
                <text x="36" y="152" class="source-code">PPL-003</text>
              </g>
              <g class="source-row">
                <rect x="0" y="176" width="26" height="26" rx="6" class="source-icon"/>
                <path d="M13 182 v10 M9.5 188 L13 192 L16.5 188" class="source-arrow"/>
                <text x="36" y="188" class="source-name">Gemini</text>
                <text x="36" y="200" class="source-code">GEM-004</text>
              </g>
              <g class="source-row">
                <rect x="0" y="224" width="26" height="26" rx="6" class="source-icon"/>
                <path d="M13 230 v10 M9.5 236 L13 240 L16.5 236" class="source-arrow"/>
                <text x="36" y="236" class="source-name">Grok</text>
                <text x="36" y="248" class="source-code">GRK-005</text>
              </g>

              <rect x="416" y="62" width="138" height="178" rx="10" class="dest-box"/>
              <g class="dest-folder">
                <path d="M428 104 h14 l4 4 h18 a3 3 0 0 1 3 3 v26 a3 3 0 0 1 -3 3 h-36 a3 3 0 0 1 -3 -3 v-30 a3 3 0 0 1 3 -3 z"/>
              </g>
              <text x="428" y="158" class="dest-path">C:\TotalRecalls\Library\</text>
              <text x="428" y="180" class="dest-status">797 files · secured</text>
              <text x="428" y="222" class="dest-note">One folder. Searchable.</text>
              <text x="428" y="238" class="dest-note">Backups yours.</text>
            </svg>
          </div>
          <div class="diag-footer">
            <span>Zero cloud relay · Direct disk write</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tr-hero {
    position: relative;
    border-bottom: 1px solid #E2E8F0;
    overflow: hidden;
    background: #FFFFFF;
  }
  .tr-hero-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(to right, #F8FAFC 1px, transparent 1px),
                      linear-gradient(to bottom, #F8FAFC 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.6;
  }
  .tr-hero-inner {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    padding: 64px 40px 96px;
  }
  .tr-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }
  .tr-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #2F7BFF;
    border: 1px solid rgba(47, 123, 255, 0.3);
    padding: 6px 12px;
  }
  .tr-hero-title {
    font-size: clamp(44px, 6vw, 68px);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 24px 0 0 0;
    color: #0B0F19;
  }
  .tr-hero-subhead {
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.6;
    color: #64748B;
    margin: 24px 0 0 0;
    max-width: 576px;
  }
  .tr-scan-form {
    margin-top: 36px;
    border: 1px solid #E2E8F0;
    background: #FFFFFF;
  }
  .tr-scan-row {
    display: flex;
    align-items: center;
  }
  .tr-scan-mark {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #64748B;
    padding: 0 8px 0 16px;
  }
  .tr-scan-input {
    flex: 1;
    background: transparent;
    border: none;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    padding: 16px 0;
    outline: none;
    min-width: 0;
    color: #0B0F19;
  }
  .tr-scan-input::placeholder {
    color: rgba(100, 116, 139, 0.7);
  }
  .tr-scan-btn {
    margin: 4px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #0B0F19;
    color: #FFFFFF;
    padding: 10px 16px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    border: none;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    flex-shrink: 0;
  }
  .tr-scan-btn:hover {
    background: #2F7BFF;
  }
  .tr-hero-ctas {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tr-cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #2F7BFF;
    color: #FFFFFF;
    padding: 14px 24px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .tr-cta-primary:hover { opacity: 0.9; }
  .tr-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid #E2E8F0;
    padding: 14px 24px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #0B0F19;
    text-decoration: none;
    transition: background 0.2s;
  }
  .tr-cta-secondary:hover { background: #F1F5F9; }
  .tr-trust-row {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    border-top: 1px solid #E2E8F0;
    padding-top: 24px;
  }
  .tr-trust-icon { color: #2F7BFF; }
  .tr-trust-title {
    font-size: 14px;
    font-weight: 600;
    margin: 8px 0 0 0;
    color: #0B0F19;
  }
  .tr-trust-sub {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: #64748B;
    margin: 2px 0 0 0;
  }

  /* Blueprint Diagram — Light/White Theme */
  .blueprint-diagram {
    background: #FFFFFF;
    border: 1.5px solid #2F7BFF;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(47, 123, 255, 0.12);
    font-family: 'IBM Plex Mono', monospace;
  }
  .diag-header {
    background: #FFFFFF;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #E2E8F0;
    font-size: 0.75rem;
  }
  .diag-title {
    color: #0F172A;
    font-weight: 700;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    background: #10B981;
    border-radius: 50%;
    box-shadow: 0 0 6px #10B981;
    display: inline-block;
  }
  .diag-status {
    color: #2F7BFF;
    font-weight: 700;
  }
  .diag-body {
    padding: 20px;
    background: #F8FBFF;
    background-image: linear-gradient(to right, #EFF6FF 1px, transparent 1px),
                      linear-gradient(to bottom, #EFF6FF 1px, transparent 1px);
    background-size: 20px 20px;
  }
  .convergence-svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .conv-path {
    fill: none;
    stroke: #2F7BFF;
    stroke-width: 2;
    stroke-dasharray: 6,4;
    opacity: 0.85;
  }
  .conv-node { fill: #2F7BFF; }
  .conv-dot { fill: #2F7BFF; }
  .source-icon { fill: #0F172A; }
  .source-arrow {
    fill: none;
    stroke: #FFFFFF;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .source-name {
    fill: #0F172A;
    font-size: 13px;
    font-weight: 700;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .source-code {
    fill: #64748B;
    font-size: 10px;
    font-family: 'IBM Plex Mono', monospace;
  }
  .dest-box {
    fill: #EFF6FF;
    stroke: #2F7BFF;
    stroke-width: 1.8;
  }
  .dest-folder path {
    fill: none;
    stroke: #2F7BFF;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .dest-path {
    fill: #0F172A;
    font-size: 11px;
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 700;
  }
  .dest-status {
    fill: #2F7BFF;
    font-size: 11px;
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 700;
  }
  .dest-note {
    fill: #475569;
    font-size: 10px;
    font-family: 'IBM Plex Mono', monospace;
  }
  .diag-footer {
    background: #FFFFFF;
    padding: 10px 16px;
    text-align: center;
    font-size: 0.7rem;
    color: #64748B;
    border-top: 1px solid #E2E8F0;
  }
  @media (max-width: 900px) {
    .tr-hero-grid { grid-template-columns: 1fr; }
    .tr-trust-row { grid-template-columns: 1fr; }
  }
</style>
