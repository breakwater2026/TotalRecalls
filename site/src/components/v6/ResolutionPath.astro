---
// Base44 ResolutionPath — Resolution Path · 01 (1:1 port)
const STEPS = [
  { n: "01", t: "Buy once", d: "Checkout via Lemon Squeezy. One-time $24, no subscription." },
  { n: "02", t: "Install", d: "Unzip and run the Windows app. Local sign-in only." },
  { n: "03", t: "Pick a provider", d: "ChatGPT, Claude, Perplexity, Gemini, or Grok." },
  { n: "04", t: "Export", d: "Chats land as Markdown + JSON under your Library folder." },
];
---
<section id="resolution" class="tr-section">
  <div class="tr-container">
    <header class="tr-section-header">
      <span class="tr-kicker">Resolution Path · 01</span>
      <h2 class="tr-section-title">From concern to resolution in under a minute.</h2>
    </header>
    <div class="tr-res-grid">
      <div class="tr-steps-grid">
        {STEPS.map((s) => (
          <div class="tr-step-card">
            <span class="tr-step-num">STEP {s.n}</span>
            <h3 class="tr-step-title">{s.t}</h3>
            <p class="tr-step-desc">{s.d}</p>
          </div>
        ))}
      </div>
      <div class="tr-drive-panel">
        <div class="tr-drive-box">
          <!-- DriveTree -->
          <div class="tr-drive-window">
            <div class="tr-win-bar">
              <span class="tr-win-dot"></span>
              <span class="tr-win-dot"></span>
              <span class="tr-win-dot"></span>
              <span class="tr-win-title">TotalRecalls — Library</span>
            </div>
            <div class="tr-drive-tree">
              <div class="tr-tree-row tr-tree-active"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg> Library</div>
              <div class="tr-tree-row"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg> ChatGPT</div>
              <div class="tr-tree-row"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg> Claude</div>
              <div class="tr-tree-row"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg> Perplexity</div>
              <div class="tr-tree-row"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg> Gemini</div>
              <div class="tr-tree-row"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg> Grok</div>
            </div>
          </div>
          <div class="tr-drive-footer">
            <span class="tr-drive-label">Action Command Center</span>
            <p class="tr-drive-title">Local storage. Your drive. Your files.</p>
            <a href="#pricing" class="tr-drive-cta">
              Begin Resolution
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tr-section { border-top: 1px solid #E2E8F0; background: #FFFFFF; }
  .tr-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 80px 40px 112px;
  }
  .tr-section-header { margin-bottom: 48px; max-width: 576px; }
  .tr-kicker {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #2F7BFF;
  }
  .tr-section-title {
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 12px 0 0 0;
    color: #0B0F19;
  }
  .tr-res-grid {
    display: grid;
    grid-template-columns: 1fr 440px;
    gap: 48px;
  }
  .tr-steps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: #E2E8F0;
    border: 1px solid #E2E8F0;
  }
  .tr-step-card {
    background: #FFFFFF;
    padding: 24px;
  }
  .tr-step-num {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #2F7BFF;
    letter-spacing: 0.16em;
  }
  .tr-step-title {
    font-size: 24px;
    font-weight: 600;
    margin: 12px 0 0 0;
    color: #0B0F19;
  }
  .tr-step-desc {
    font-size: 14px;
    line-height: 1.6;
    color: #64748B;
    margin: 8px 0 0 0;
  }
  .tr-drive-panel { position: sticky; top: 96px; height: fit-content; }
  .tr-drive-box { border: 1px solid #E2E8F0; background: #FFFFFF; }
  .tr-drive-window { border-bottom: 1px solid #E2E8F0; }
  .tr-win-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border-bottom: 1px solid #E2E8F0;
    background: #F8FAFC;
  }
  .tr-win-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #E2E8F0;
  }
  .tr-win-title {
    margin-left: 12px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #64748B;
  }
  .tr-drive-tree {
    padding: 12px 0;
    display: flex;
    flex-direction: column;
  }
  .tr-tree-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #64748B;
  }
  .tr-tree-active {
    color: #0B0F19;
    font-weight: 500;
  }
  .tr-drive-footer { padding: 24px; }
  .tr-drive-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #64748B;
  }
  .tr-drive-title {
    font-size: 20px;
    font-weight: 600;
    margin: 8px 0 0 0;
    color: #0B0F19;
  }
  .tr-drive-cta {
    margin-top: 20px;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #2F7BFF;
    color: #FFFFFF;
    padding: 14px 20px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .tr-drive-cta:hover { opacity: 0.9; }
  @media (max-width: 900px) {
    .tr-res-grid { grid-template-columns: 1fr; }
    .tr-steps-grid { grid-template-columns: 1fr; }
    .tr-drive-panel { position: static; }
  }
</style>
