---
// Top Live Feed Ticker Bar (Exact Base44 Spacing & Microcopy)
---
<div class="v6-ticker">
  <div class="ticker-content">
    <div class="ticker-left">
      <span class="live-indicator"><span class="red-dot"></span>LIVE FEED</span>
      <span class="ticker-log">2026-08-15 · claude · ui revision · 4 threads orphaned</span>
      <span class="ticker-sep">|</span>
      <span class="ticker-log">2026-08-14 · perplexity · session expired · research trail gone</span>
    </div>
    <div class="ticker-right">
      <span class="ticker-sys">v1.3.0 · SECURED_EXPORT</span>
    </div>
  </div>
</div>

<style>
  .v6-ticker {
    background: #0F172A;
    color: #F8FAFC;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    padding: 6px 20px;
    border-bottom: 1px solid #1E293B;
  }
  .ticker-content {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    white-space: nowrap;
    overflow: hidden;
  }
  .ticker-left {
    display: flex;
    align-items: center;
    gap: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .live-indicator {
    background: #991B1B;
    color: #FCA5A5;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.68rem;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    letter-spacing: 0.5px;
  }
  .red-dot {
    width: 6px;
    height: 6px;
    background: #EF4444;
    border-radius: 50%;
    box-shadow: 0 0 6px #EF4444;
  }
  .ticker-log {
    color: #CBD5E1;
    opacity: 0.9;
  }
  .ticker-sep {
    color: #334155;
  }
  .ticker-right {
    color: #38BDF8;
    font-weight: 600;
    font-size: 0.7rem;
  }
  @media (max-width: 768px) {
    .v6-ticker { display: none; }
  }
</style>
