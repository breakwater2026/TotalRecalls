---
// Base44 ThreatFeed — LIVE FEED ticker (1:1 port)
const EVENTS = [
  "2026-08-15 · chatgpt · export failed · thread lost",
  "2026-08-15 · claude · ui revision · 4 threads orphaned",
  "2026-08-14 · perplexity · session expired · research trail gone",
  "2026-08-14 · gemini · takeout parse error · 2 archives unreadable",
  "2026-08-13 · grok · tab closed · debug session lost",
  "2026-08-13 · chatgpt · 9 months of prompts · no backup",
];
const row = [...EVENTS, ...EVENTS];
---
<div class="bg-foreground text-background tr-ticker-bar">
  <span class="tr-live-badge">
    <span class="tr-live-dot"></span> Live Feed
  </span>
  <div class="tr-ticker-viewport">
    <div class="tr-ticker-track">
      {row.map((e, i) => (
        <span class="tr-ticker-item"><span class="tr-ticker-mark">▍</span>{e}</span>
      ))}
    </div>
  </div>
</div>

<style>
  .tr-ticker-bar {
    height: 36px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #0B0F19;
    color: #FFFFFF;
  }
  .tr-live-badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    height: 100%;
    background: #DC2626;
    color: #FFFFFF;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 500;
  }
  .tr-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #FFFFFF;
    animation: tr-pulse 1.2s ease-in-out infinite;
  }
  @keyframes tr-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .tr-ticker-viewport {
    position: relative;
    flex: 1;
    overflow: hidden;
  }
  .tr-ticker-track {
    display: flex;
    white-space: nowrap;
    animation: tr-scroll 40s linear infinite;
    will-change: transform;
  }
  @keyframes tr-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .tr-ticker-item {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.8);
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tr-ticker-mark {
    color: #DC2626;
  }
</style>
