---
import "../styles/variables.css";
import "../styles/main.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title?: string;
  description?: string;
}

const { title = "TotalRecalls", description = "Export and own every AI conversation." } = Astro.props;
const site = "https://totalrecalls.app";
const canonicalPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}${canonicalPath}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script src="/js/config.js" is:inline defer></script>
  </head>
  <body class="theme-light">
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
