---
import "../styles/main.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/ibm-plex-mono/400.css";

export interface Props {
  title?: string;
  description?: string;
}

const { title = "TotalRecalls — Recall every AI conversation.", description = "A Windows app that saves your AI conversations as Markdown + JSON you keep forever." } = Astro.props;
const site = "https://totalrecalls.app";
const canonicalPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}${canonicalPath}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script src="/js/config.js" is:inline defer></script>
  </head>
  <body class="bg-background text-foreground antialiased selection:bg-primary selection:text-white">
    <slot />
    
    <!-- Global Footer Statement — Pure HTML, no JS required -->
    <footer class="border-t border-border bg-background py-8 mt-12">
      <div class="mx-auto max-w-[1400px] px-5 md:px-10 text-center">
        <p class="font-body text-muted-foreground text-[13.5px] leading-relaxed italic whitespace-nowrap overflow-x-auto">
          Built by a solo developer who was tired of losing months of AI conversations to broken exports and shifting UIs.
        </p>
        <p class="font-mono text-[11px] text-muted-foreground mt-2 flex items-center justify-center gap-3">
          <a href="/legals/" class="text-primary hover:underline">Legal & Policies</a>
          <span class="text-border-foreground/30">·</span>
          <a href="/release-notes/" class="text-primary hover:underline">Release Notes</a>
        </p>
        <p class="font-mono text-[10px] text-muted-foreground/60 mt-3">
          Not affiliated with or endorsed by OpenAI, Anthropic, Perplexity, Google, or xAI.
        </p>
      </div>
    </footer>

  </body>
</html>
