---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Buy TotalRecalls" description="One-time $24 launch price via Lemon Squeezy. No subscription.">
  <h1>Buy TotalRecalls</h1>

  <section class="price-card">
    <h2>Launch Price</h2>
    <div class="price-block">
      <span class="price-strike"><strike>$49</strike></span>
      <span class="price-current" data-tr-price></span>
      <span class="price-badge">launch price</span>
    </div>
    <p class="price-note">One-time purchase · Windows app · Local files only</p>
    <p>Pay once with Lemon Squeezy. You'll receive a download link for the Windows app immediately after purchase.</p>
    <a href="" data-tr-buy class="buy-button buy-lg">Buy for $<span data-tr-price></span></a>
    <div id="checkout-pending" class="checkout-pending">
      Checkout link not configured yet — the button below scrolls to the purchase section.
    </div>
  </section>

  <section>
    <h2>What You Get</h2>
    <ul>
      <li>Export from ChatGPT, Claude, Perplexity, Gemini (Takeout), Grok</li>
      <li>Local Markdown + JSON files under your Library folder</li>
      <li>No telemetry · No background services · No installers</li>
      <li>Free minor updates during the launch period</li>
    </ul>
  </section>

  <section>
    <h2>Refund Policy</h2>
    <p>All sales are final (digital download). Try the free guides first to verify the tool meets your needs.</p>
  </section>

  <section class="footer-cta" style="background: var(--color-midnight); color: var(--color-surface); text-align: center;">
    <h2 style="color: var(--color-surface);">Already purchased?</h2>
    <p style="margin-bottom: var(--space-4);">Download the ZIP directly from your receipt email or <a href="/download/" style="color: var(--color-surface); text-decoration: underline;">click here</a>.</p>
  </section>

</BaseLayout>
