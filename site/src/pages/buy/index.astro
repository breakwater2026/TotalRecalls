---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Buy TotalRecalls" description="One-time $24 purchase via Lemon Squeezy.">
  <h1>Buy TotalRecalls</h1>
  <div class="price-block">
    <span data-tr-price></span> <span data-tr-normal-price></span>
  </div>
  <a href="" data-tr-buy class="buy-button">Buy for $<span data-tr-price></span></a>
  <div id="checkout-pending" class="checkout-pending">
    Checkout link not configured yet — the button below scrolls to the purchase section.
  </div>
</BaseLayout>
