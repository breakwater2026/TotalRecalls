const STORE_URL = "https://totalrecalls.lemonsqueezy.com";
---
<PageLayout title="Buy TotalRecalls — $24 one-time" description="Buy TotalRecalls for Windows. A one-time $24 USD purchase, no subscription. Secure checkout via Lemon Squeezy." breadcrumbs={[{ label: "Buy" }]}>

  <h1>Buy TotalRecalls</h1>
  <p>One-time <strong>$24 USD</strong> &mdash; discounted launch price. No subscription, no account required. Every update included.</p>

  <section class="price-card">
    <h2>Launch Price</h2>
    <div class="price-block">
      <span class="price-current" data-tr-price>$24</span>
      <span class="price-badge">launch price</span>
    </div>
    <p class="price-note">One-time purchase &middot; Windows app &middot; Local files only</p>
    <p>Pay once with Lemon Squeezy. Your download link and receipt arrive by email immediately after purchase.</p>
    <a href={CHECKOUT_URL} data-tr-buy class="buy-button buy-lg">Buy TotalRecalls — <span data-tr-price>$24</span></a>
    <p class="guarantee-note">Not ready to buy? A free version is available now — download the app and test it on your own chats before paying.</p>
