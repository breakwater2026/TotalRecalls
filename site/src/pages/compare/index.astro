  <tr style="background:#f0f4ff;">
    <th>Feature</th><th>Official Exports</th><th>TotalRecalls</th>
  </tr>
  <tr>
    <td>Formats</td>
    <td>JSON dump (machine-only)</td>
    <td>Markdown + JSON (human + machine)</td>
  </tr>
  <tr>
    <td>Search</td>
    <td>File search only</td>
    <td>Full-text search across all providers</td>
  </tr>
  <tr>
    <td>Bulk export</td>
    <td>Manual, one provider at a time</td>
    <td>All providers in one click</td>
  </tr>
  <tr>
    <td>Migration</td>
