---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Compare — TotalRecalls" description="TotalRecalls vs official exports and DIY scripts.">
  <h1>Compare</h1>
  <p>How TotalRecalls stacks up against the two realistic alternatives: each provider's official export, and do-it-yourself scripts.</p>

  <table class="compare-table">
  <thead>
  <tr>
    <th>Feature</th><th>Official exports</th><th>DIY scripts</th><th>TotalRecalls</th>
  </tr>
  </thead>
  <tbody>
  <tr>
    <td>Formats</td>
    <td>JSON dump (machine-only)</td>
    <td>Whatever you write</td>
    <td>Markdown + JSON (human + machine)</td>
  </tr>
  <tr>
    <td>Bulk export</td>
    <td>Manual, one provider at a time</td>
    <td>You maintain the script</td>
    <td>All five providers in one app</td>
  </tr>
  <tr>
    <td>Setup</td>
    <td>Per-provider export flows</td>
    <td>Hours of scripting + debugging</td>
    <td>Unzip and run (Windows)</td>
  </tr>
  <tr>
    <td>Migration</td>
    <td>Not supported</td>
    <td>Up to you</td>
    <td>Unified Library folder, portable anywhere</td>
  </tr>
  <tr>
    <td>Full-text search across providers</td>
    <td>No</td>
    <td>Possible with extra tooling</td>
    <td><em>Planned</em> (optional upgrade)</td>
  </tr>
  <tr>
    <td>Folder sync (cloud / NAS)</td>
    <td>No</td>
    <td>Manual</td>
    <td><em>Planned</em> — today: sync the folder yourself</td>
  </tr>
  <tr>
    <td>Cost</td>
    <td>Free (data locked in)</td>
    <td>Free (your time)</td>
    <td>$24 one-time (data fully yours)</td>
  </tr>
  </tbody>
  </table>

  <p><a href="/pricing/" class="buy-button buy-lg" data-tr-buy>Get TotalRecalls — <span data-tr-price>$24</span></a></p>
</BaseLayout>
