---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout title="Pricing Comparison — TotalRecalls" description="Free official exports vs. one-time utility.">
  <h1>Pricing Comparison</h1>
  <p>Official AI exports are free. TotalRecalls is a paid utility with one key difference: your data stays local.</p>
  <table border="1" cellpadding="8" style="width:100%; border-collapse: collapse;">
  <tr style="background:#f0f4ff;">
    <th>Aspect</th><th>Official Exports</th><th>TotalRecalls</th>
  </tr>
  <tr>
    <td>Cost</td>
    <td>Free</td>
    <td>$24 one-time (<span data-tr-normal-price></span>)</td>
  </tr>
  <tr>
    <td>Output</td>
    <td>JSON only</td>
    <td>Markdown + JSON</td>
  </tr>
  <tr>
    <td>Unified Library</td>
    <td>No</td>
    <td>Yes</td>
  </tr>
  <tr>
    <td>Search</td>
    <td>No</td>
    <td>Yes</td>
  </tr>
  </table>
</BaseLayout>
