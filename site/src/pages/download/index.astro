---
import PageLayout from "../../layouts/PageLayout.astro";

// Free Tier release. Real build artifacts — recompute after each PyInstaller build:
//   Get-FileHash dist/TotalRecalls-1.0.0-free-tier.zip -Algorithm SHA256
import { currentVersion } from "../../data/releases.json";
const date = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const ZIP_URL = "/downloads/TotalRecalls-1.0.0-free-tier.zip";
const ZIP_SIZE_MB = 17.8;
const SHA256 = "1d2580f5dfb93026630ece8ae1d2a0543fc824a7b9d93bd8a8f94e2a1b9dbd3f";
---
<PageLayout
  title={`Download TotalRecalls ${currentVersion}`}
  description={`Download TotalRecalls ${currentVersion} for Windows 10/11. Local-only AI conversation archive as Markdown + JSON. Released ${date}.`}
  breadcrumbs={[{ label: "Download" }]}
>
  <h1>Download TotalRecalls for Windows</h1>

  <p class="version-banner">
    <strong>Latest release:</strong> TotalRecalls {currentVersion} &middot; {date}
  </p>

  <section>
    <h2>Get Your Download — Free Tier</h2>
    <p>
      Full-featured app, no installation, no account required. The Free Tier
      includes <strong>3 providers</strong> (Perplexity, ChatGPT, Claude) and up to
      <strong>5 conversations per download</strong>.
    </p>
    <p>
      <a class="download-btn" href={ZIP_URL}>
        &#8681; Download TotalRecalls {currentVersion} — Free Tier (ZIP, ~{ZIP_SIZE_MB} MB)
      </a>
    </p>
    <p>
      <a href="/buy/" class="buy-pro-link">
        Need all 8 providers &amp; unlimited conversations? <strong>Upgrade to Pro — one-time $24<span class="tr-usd">USD</span></strong>
      </a>
    </p>
    <p class="hash-line">
      <strong>SHA-256:</strong> <code>{SHA256}</code>
    </p>
    <p class="hash-note">
      Verify the download with PowerShell: <code>Get-FileHash TotalRecalls-{currentVersion}-free-tier.zip -Algorithm SHA256</code>
    </p>
    <p class="check-updates">
      <strong>Check for updates:</strong> Subscribe to <a href="/release-notes/">Release Notes</a> &mdash;
      the latest build is always published there first.
      Auto-update is on the roadmap.
    </p>
  </section>

  <section>
    <h2>Already purchased?</h2>
    <p>
      Re-download any time from this page, and use the license key from your
      purchase email to unlock Pro in the app. Your receipt and invoice were
      emailed to you by Paddle at the time of purchase — contact
      <a href="/support/">support</a> if you need another copy.
    </p>
    <p>
      <strong>The Free Tier is available now</strong> — download the app and test it
      on your own chats before paying a cent. Downloads are limited to 3 AI providers and
      5 conversations per download — our try-before-you-buy mechanism. Purchases
      are one-time; the core app keeps receiving free updates for the life of
      the product. New features (add-ons) are separate purchases.
    </p>
  </section>

  <section>
    <h2>What's Inside the ZIP?</h2>
    <ul>
      <li><code>TotalRecalls.exe</code> &mdash; the Windows app (portable, no installer)</li>
      <li><code>README.txt</code> &mdash; quick-start notes and version history</li>
    </ul>
    <p>No installers, no background services, no telemetry. Just unzip and run.</p>
  </section>

  <section class="technical-notes">
    <h2>Technical Notes</h2>
    <ul>
      <li>Windows 10/11 required. No Mac or mobile build yet.</li>
      <li>Windows 11 Smart App Control may block unsigned apps with no override. Code-signing is on the roadmap. See <a href="/guides/smartscreen/">SmartScreen instructions</a>.</li>
      <li>Gemini uses your Google Takeout folder/JSON (most reliable path). See <a href="/guides/gemini-takeout-archive/">Gemini Takeout guide</a>.</li>
      <li>All downloads land in a folder <em>you choose</em> on your PC. TotalRecalls never sees, stores, or transmits your AI chat data.</li>
    </ul>
  </section>

  <section>
    <h2>How to Use the App (4 steps)</h2>
    <ol>
      <li><strong>Unzip</strong> the archive to any folder (e.g. <code>Desktop\TotalRecalls</code>).</li>
      <li><strong>Run</strong> <code>TotalRecalls.exe</code>. SmartScreen may show a warning on first launch &mdash; click <em>More info &rarr; Run anyway</em>.</li>
      <li><strong>Pick a provider</strong> (Perplexity, ChatGPT, or Claude &mdash; the Free Tier includes these three; <em>Pro adds Gemini, Grok, DeepSeek, Mistral, and Qwen</em>) and sign in locally. For Gemini, point at your Takeout folder instead.</li>
      <li><strong>Choose an output folder</strong> and click <em>Download</em>. Your Markdown + JSON files are written straight to disk.</li>
    </ol>
  </section>

  <section>
    <h2>Privacy &amp; Security</h2>
    <ul>
      <li>Your AI session tokens stay on your machine</li>
      <li>We never host your chats, downloads, or credentials</li>
      <li>No cloud locker &mdash; data lives where you put it</li>
      <li>No TotalRecalls account required</li>
      <li>No background processes</li>
      <li>No telemetry, no analytics, no tracking pixels</li>
      <li>You can read the full <a href="/privacy/">Privacy Policy</a> or the <a href="/privacy/">standalone privacy page</a></li>
    </ul>
  </section>

  <section>
    <h2>Need Help?</h2>
    <ul>
      <li><a href="/guides/smartscreen/">SmartScreen instructions</a></li>
      <li><a href="/guides/gemini-takeout-archive/">Gemini Takeout guide</a></li>
      <li><a href="/guides/export-chatgpt-conversations/">ChatGPT download guide</a></li>
      <li><a href="/guides/backup-perplexity-threads/">Perplexity download guide</a></li>
      <li><a href="/guides/export-claude-chat-history/">Claude Projects download guide</a></li>
      <li><a href="/guides/deepseek/">DeepSeek download guide</a></li>
      <li><a href="/guides/mistral/">Mistral download guide</a></li>
      <li><a href="/guides/qwen/">Qwen download guide</a></li>
      <li><a href="/guides/grok/">Grok download guide</a></li>
      <li><a href="/faq/">FAQ</a></li>
      <li>Email <a href="mailto:support@totalrecalls.app">support@totalrecalls.app</a></li>
    </ul>
  </section>

  <section class="footer-cta" style="background: var(--color-midnight); color: var(--color-surface); text-align: center;">
    <h2 style="color: var(--color-surface);">Ready to own your AI conversations?</h2>
    <div class="price-block" style="justify-content: center;">
      <span class="price-current" data-tr-price>$24<span class="tr-usd">USD</span></span>
      <span class="price-badge">launch price</span>
    </div>
  </section>

</PageLayout>