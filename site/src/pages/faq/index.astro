---
import PageLayout from "../../layouts/PageLayout.astro";
const faqs = [
  {
    "q": "What is TotalRecalls?",
    "a": "A small Windows app that downloads your AI chat history from ChatGPT, Claude, Perplexity, Gemini (Google Takeout), Grok, DeepSeek, Mistral, and Qwen Chat into local Markdown + JSON files you own forever. See <a href=\"/how-it-works/\">How It Works</a>."
  },
  {
    "q": "How much does it cost?",
    "a": "$24 USD launch price. One-time purchase. No subscription. No monthly AI archive fee. A Free Tier is available now — download the app and test it before paying. The Free Tier is limited to 3 AI providers and 5 conversations per provider. See <a href='/#pricing'>Pricing</a> for the full breakdown."
  },
  {
    "q": "Do I need an account?",
    "a": "No. TotalRecalls does not require a TotalRecalls account. You sign in only to the AI providers you already use."
  },
  {
    "q": "Do you store my chats or tokens?",
    "a": "No. Your AI session tokens stay on your machine. We never host your chats, your downloads, or your credentials. Read the <a href=\"/privacy/\">Privacy Policy</a>."
  },
  {
    "q": "Does TotalRecalls run in the cloud?",
    "a": "No. It's a local Windows app. Downloads land in a folder you choose on your PC."
  },
  {
    "q": "What providers are supported?",
    "a": "ChatGPT, Claude, Perplexity, Gemini (via Google Takeout import), Grok, DeepSeek, Mistral, and Qwen Chat. See the <a href=\"/guides/\">Guides</a> for per-provider walkthroughs."
  },
  {
    "q": "How do downloads work?",
    "a": "<ol>\n        <li>Open the app</li>\n        <li>Pick a provider</li>\n        <li>Sign in locally (or choose a Gemini Takeout folder)</li>\n        <li>Pick an output folder and click <em>Download</em></li>\n      </ol>\n      Your Markdown + JSON files are written straight to disk on your machine."
  },
  {
    "q": "Does this replace official downloads?",
    "a": "No. It complements them. TotalRecalls catches conversations the official download tools miss (shared links, archived conversations, partial histories) and writes them in a single Markdown + JSON format you can grep, version, and search."
  },
  {
    "q": "Is the app safe?",
    "a": "Yes. The app runs locally on your Windows machine, never connects to a TotalRecalls server, never hosts your chats, and ships with no telemetry. You can verify by inspecting network traffic with Wireshark if you want."
  },
  {
    "q": "Does it work on Mac?",
    "a": "Not yet. Windows 10/11 today. Developing an application for Linux and Apple (macOS) is in the works."
  },
  {
    "q": "Does it work on mobile?",
    "a": "No. Windows only."
  },
  {
    "q": "What's inside the ZIP?",
    "a": "Two files: <code>TotalRecalls.exe</code> (the app, portable &mdash; no installer) and <code>README.txt</code> (release notes + quick-start). See the <a href=\"/download/\">Download page</a>."
  },
  {
    "q": "Will future features cost extra?",
    "a": "The $24 USD launch price covers the Downloader. Updates (bug fixes and provider-compatibility fixes) are free for the life of the product. Upgrades (new features, new add-ons like RAG containers and multi-device memory) are separate paid purchases. Smart Search Engine (SSE) is available now as an add-on."
  },
  {
    "q": "Do I need the Smart Search Engine (SSE) add-on?",
    "a": "No. TotalRecalls Pro downloads and saves everything without it. Smart Search Engine (SSE) is for people who want to find things inside a large archive."
  },
  {
    "q": "Can I buy Smart Search Engine (SSE) without Pro?",
    "a": "No. It works on the Library that Pro builds. The bundle gives you both."
  },
  {
    "q": "Does Smart Search Engine (SSE) upload my conversations?",
    "a": "No. It runs on your PC. The only internet use is a one-time download of the search model during setup."
  },
  {
    "q": "Does it work offline?",
    "a": "Yes, after setup."
  },
  {
    "q": "Do I need an AI model or LM Studio?",
    "a": "No. Search and retrieval-only chat work without one. A local model is optional, if you want written answers."
  },
  {
    "q": "What do I need to run Smart Search Engine (SSE)?",
    "a": "Windows 10 or 11, about 8 GB of RAM and about 2 GB of free disk space. No graphics card."
  },
  {
    "q": "How does Smart Search Engine (SSE) stay up to date?",
    "a": "It re-indexes automatically after downloads and on a schedule."
  },
  {
    "q": "Does Smart Search Engine (SSE) work with every provider?",
    "a": "It searches all eight: ChatGPT, Claude, Perplexity, Gemini, Grok, DeepSeek, Mistral, and Qwen Chat. Search quality for non-English conversations may vary."
  },
  {
    "q": "Is Smart Search Engine (SSE) a subscription?",
    "a": "No. It’s a one-time purchase: $29 at launch (regular $58). There is no subscription."
  },
  {
    "q": "What’s your refund policy for the Downloader?",
    "a": "There is no refund on the Downloader. The Free Tier is our try-before-you-buy mechanism — you can test a real download on your own chats before paying anything. Your statutory consumer rights are never excluded.",
  },
  {
    "q": "Is Smart Search Engine (SSE) included in Pro updates?",
    "a": "Updates (bug fixes) to Downloader Pro are free and do not include Smart Search Engine (SSE). Smart Search Engine (SSE) is a separate purchase; its own updates are free, and new modules are paid upgrades."
  },
  {
    "q": "Is there a bundle?",
    "a": "Yes. Downloader Pro + Smart Search Engine (SSE) bundle is $49 USD at launch (regular $98). If you already own the Downloader, add Smart Search Engine (SSE) for $29 USD at launch."
  },
  {
    "q": "Can prices change?",
    "a": "Yes. Prices may change at any time without advance notice. The price you pay is the price shown at checkout when you buy."
  },
  {
    "q": "What’s your refund policy for Smart Search Engine (SSE)?",
    "a": "7 days, no questions asked. The Downloader itself has no refund — the Free Tier is the try-before-you-buy."
  },
  {
    "q": "What do I get today, and what is coming?",
    "a": "Today: search by meaning, keyword or both; plain-English questions turned into SQL; chat with your archive; Obsidian and Notion connections; automatic re-index. Coming as paid upgrades (separate purchases): the PII Scrubber, fine-tuning export, Consensus Auditor, Knowledge Graph and embedding benchmark."
  },
  {
    "q": "Does it work with free-tier accounts?",
    "a": "Yes. TotalRecalls works with free-tier ChatGPT, Claude, Perplexity, Grok, DeepSeek, Mistral, and Qwen Chat accounts. Gemini requires a Google account with Takeout enabled."
  },
  {
    "q": "Are images, code blocks, and attachments included?",
    "a": "Chat text and code blocks download as Markdown; attachment references are preserved alongside (e.g. sources.json). The binary files themselves stay in your provider account."
  },
  {
    "q": "What happens when a provider changes its site?",
    "a": "TotalRecalls is updated to keep downloads working when providers change their interfaces. New versions are listed in the <a href=\"/release-notes/\">Release Notes</a>."
  },
  {
    "q": "How large can downloads get?",
    "a": "Practically unlimited. Downloads are streamed to disk, so a 50,000-message archive works the same as a 500-message one. The only limit is your free disk space."
  },
  {
    "q": "Can I get help?",
    "a": "Yes. Email <a href=\"mailto:support@totalrecalls.app\">support@totalrecalls.app</a>, or see the <a href=\"/support/\">Support</a> page."
  }
];

// The visible FAQ and the FAQPage schema are generated from the SAME array, so they cannot
// drift apart. Answers are HTML for the page; the schema text is the tag-stripped version.
const stripTags = (s) =>
  s
    .replace(/<[^>]+>/g, "")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&rsquo;/g, "\u2019")
    .replace(/&lsquo;/g, "\u2018")
    .replace(/&rdquo;/g, "\u201c")
    .replace(/&mdash;/g, "\u2014")
    .replace(/&middot;/g, "\u00b7")
    .replace(/\s+/g, " ")
    .trim();

const faqHtml = faqs.map((f) => `<dt>${f.q}</dt><dd>${f.a}</dd>`).join("");

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: stripTags(f.a) },
  })),
};
---
<PageLayout
  title="Frequently Asked Questions (FAQ) — TotalRecalls"
  description="Frequently asked questions about TotalRecalls: pricing, providers, privacy, refunds, and how downloads work."
  breadcrumbs={[{ label: "FAQ" }]}
>
  <h1>FAQ</h1>

  <dl set:html={faqHtml} />


  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</PageLayout>
