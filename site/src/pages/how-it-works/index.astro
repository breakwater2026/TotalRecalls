    <h2 style="color: var(--tr-paper);">Ready to try it?</h2>
    <a href="/#pricing" class="buy-button buy-lg" data-tr-buy>Buy TotalRecalls — <span data-tr-price>$24<span class="tr-usd">USD</span></span></a>
    <p><a href="/download/" style="color: var(--tr-paper);">Already purchased? Download ZIP</a></p>
  </section>

</PageLayout>
