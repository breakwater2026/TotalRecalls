---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThreatFeed from "../components/landing/ThreatFeed.jsx";
import Nav from "../components/landing/Nav.jsx";
import SentinelHero from "../components/landing/SentinelHero.jsx";
import ResolutionPath from "../components/landing/ResolutionPath.jsx";
import RiskMatrix from "../components/landing/RiskMatrix.jsx";
import LibraryPreview from "../components/landing/LibraryPreview.jsx";
import Guides from "../components/landing/Guides.jsx";
import PricingSection from "../components/landing/PricingSection.jsx";
import SiteFooter from "../components/landing/SiteFooter.jsx";
---

<BaseLayout title="TotalRecalls — Recall every AI conversation." description="A Windows app that saves your AI conversations as Markdown + JSON you keep forever.">
  <div class="min-h-screen bg-background">
    <ThreatFeed client:load />
    <Nav client:load />
    <SentinelHero client:load />
    <ResolutionPath client:load />
    <RiskMatrix client:load />
    <LibraryPreview client:load />
    <Guides client:load />
    <PricingSection client:load />
    <SiteFooter client:load />
  </div>
</BaseLayout>
