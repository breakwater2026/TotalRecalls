---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/landing/Nav.jsx";
import Hero from "../components/landing/tr/Hero.jsx";
import HowItWorks from "../components/landing/tr/HowItWorks.jsx";
import DemoSection from "../components/landing/tr/DemoSection.jsx";
import Ownership from "../components/landing/tr/Ownership.jsx";
import Pricing from "../components/landing/tr/Pricing.jsx";
import Trust from "../components/landing/tr/Trust.jsx";
import Faq from "../components/landing/tr/Faq.jsx";
import SearchSection from "../components/landing/tr/SearchSection.jsx";
import SiteIndex from "../components/landing/tr/SiteIndex.jsx";
import Footer from "../components/landing/tr/Footer.jsx";
---

<BaseLayout title="TotalRecalls — Recall every AI conversation." description="A Windows app that saves your AI conversations as Markdown + JSON you keep forever.">
  <div class="min-h-screen bg-tr-obsidian">
    <Nav client:load />
    <Hero client:load />
    <HowItWorks client:load />
    <DemoSection client:load />
    <Ownership client:load />
    <SearchSection client:load />
    <Pricing client:load />
    <Trust client:load />
    <Faq client:load />
    <SiteIndex client:load />
    <Footer client:load />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "TotalRecalls",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Windows 10, Windows 11",
    "offers": {
      "@type": "Offer",
      "price": "24",
      "priceCurrency": "USD"
    },
    "description": "A Windows app that downloads your AI chat history from ChatGPT, Claude, Perplexity, Gemini, Grok, DeepSeek, Mistral, and Qwen into local Markdown + JSON files you own forever.",
    "url": "https://totalrecalls.app/",
    "downloadUrl": "https://totalrecalls.app/download/",
    "softwareVersion": "1.0.0",
    "author": {
      "@type": "Organization",
      "name": "TotalRecalls",
      "url": "https://totalrecalls.app/"
    }
  })} />
</BaseLayout>
