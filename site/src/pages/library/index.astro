---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/landing/Nav.jsx";
import LibraryPage from "../../components/landing/tr/LibraryPage.jsx";
import Footer from "../../components/landing/tr/Footer.jsx";
---

<BaseLayout
  title="Local Library Folder & Architecture — TotalRecalls"
  description="Every AI conversation TotalRecalls saves becomes a readable Markdown file and raw JSON in your local library folder — openable, searchable, and permanent."
>
  <div class="min-h-screen bg-tr-obsidian">
    <Nav client:load />
    <main id="top">
      <LibraryPage client:load />
    </main>
    <Footer client:load />
  </div>
</BaseLayout>
