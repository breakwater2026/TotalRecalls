---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="TotalRecalls — Midnight Blue Theme Preview" description="Midnight Blue color variant preview for TotalRecalls redesign.">
  <div style="background: linear-gradient(135deg, #030712 0%, #0F172A 50%, #1E1B4B 100%); color: #ffffff; min-height: 100vh; padding: 4rem 1rem;">
    <div style="max-width: 800px; margin: 0 auto; background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(12px); border: 1px solid rgba(47, 123, 255, 0.3); border-radius: 16px; padding: 3rem; box-shadow: 0 20px 50px rgba(0,0,0,0.6);">
      <div style="text-align: center; margin-bottom: 2rem;">
        <span style="background: #2F7BFF; color: #ffffff; padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Theme Variant: Midnight Blue</span>
        <h1 style="font-size: 3rem; font-weight: 800; margin-top: 1rem; color: #ffffff;">Own every AI conversation.</h1>
        <p style="color: #94A3B8; font-size: 1.2rem; max-width: 600px; margin: 1rem auto 0 auto;">A small Windows app that saves your ChatGPT, Claude, Perplexity, Gemini, and Grok chats into a private folder on your computer.</p>
      </div>
      <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 2.5rem;">
        <a href="/pricing/" style="background: #2F7BFF; color: #ffffff; padding: 14px 32px; border-radius: 8px; font-weight: 700; text-decoration: none; box-shadow: 0 4px 20px rgba(47,123,255,0.5);">Get TotalRecalls — $24</a>
        <a href="/how-it-works/" style="background: transparent; border: 2px solid #2F7BFF; color: #2F7BFF; padding: 14px 28px; border-radius: 8px; font-weight: 700; text-decoration: none;">How It Works</a>
      </div>
    </div>
  </div>
</BaseLayout>
