---
import PageLayout from "../../layouts/PageLayout.astro";
import releases from "../../data/releases.json";
---
<PageLayout
  title="Release Notes & Version History — TotalRecalls"
  description="Complete release notes and version history for TotalRecalls Downloader and Smart Search Engine. What's new in each Windows release."
  breadcrumbs={[{ label: "Release Notes" }]}
>
  <h1>Release Notes</h1>

  <p>
    TotalRecalls ships updates regularly. The current release is{" "}
    <strong>{releases.releases[0].tag}</strong> ({releases.releases[0].date}).
  </p>

  {releases.releases.map((r) => (
    <section>
      <h2>{r.tag} — {r.title}</h2>
      <p class="text-muted-foreground">{r.date} · {r.summary}</p>
      <ul>
        {r.changes.map((c) => <li>{c}</li>)}
      </ul>
    </section>
  ))}
</PageLayout>
