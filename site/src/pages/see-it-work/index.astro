---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/landing/Nav.jsx";
import SeeItWorkPage from "../../components/landing/tr/SeeItWorkPage.jsx";
import Footer from "../../components/landing/tr/Footer.jsx";
import { buildVideoJsonLd } from "../../components/landing/tr/SeeItWorkDemos";
---

<BaseLayout
  title="Interactive Provider Walkthroughs — TotalRecalls"
  description="Watch an AI conversation become files on your PC. Real screen recordings show conversations downloaded into local Markdown and JSON files on Windows."
>
  <div class="min-h-screen bg-tr-obsidian">
    <Nav client:load />
    <main id="top">
      <SeeItWorkPage client:load />
    </main>
    <Footer client:load />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(buildVideoJsonLd("chatgpt", "/see-it-work/"))} />
</BaseLayout>
