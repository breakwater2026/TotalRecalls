---
import PageLayout from "../../layouts/PageLayout.astro";
---

<PageLayout 
  title="Windows Firewall — TotalRecalls" 
  description="Windows Firewall and Anti-Virus configuration guidance for TotalRecalls."
  breadcrumbs={[{ label: "Windows Firewall" }]}
>

<div class="mb-6">
  <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-primary block mb-2">Windows Firewall · 06</span>
  <h1 class="font-heading text-3xl md:text-5xl font-bold tracking-tight text-foreground">Windows Firewall</h1>
  <p class="font-mono text-[11px] text-muted-foreground uppercase tracking-widest mt-2">Security & Firewall Configuration Guidance</p>
</div>

<div class="space-y-6 text-[14.5px] leading-relaxed text-muted-foreground border-t border-border/60 pt-8 my-8">
  <div class="bg-card/60 border border-border/80 p-8 rounded-sm text-center">
    <p class="font-heading text-xl font-semibold text-foreground mb-3">Content coming later today.</p>
    <p class="font-body text-muted-foreground text-[14.5px] max-w-lg mx-auto leading-relaxed">
      This page will provide step-by-step instructions for configuring Windows Defender Firewall, Anti-Virus exceptions, and SmartScreen settings for TotalRecalls.
    </p>
  </div>
</div>

<div class="mt-12 pt-6 border-t border-border/60 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px] text-muted-foreground">
  <span>Need help now? Email <a href="mailto:support@totalrecalls.app" class="text-primary hover:underline">support@totalrecalls.app</a></span>
  <a href="/" class="hover:text-primary transition-colors">← Back to TotalRecalls Home</a>
</div>

</PageLayout>
